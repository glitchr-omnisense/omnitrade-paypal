{
    "name": "omnitrade/paypal",
    "type": "library",
    "description": "Omnitrade PayPal: orders approved on PayPal's page and captured on return, authorizations, refunds, saved PayPal accounts charged without a page (Vault v3) and webhook events, over the REST API.",
    "keywords": [
        "payment",
        "paypal",
        "omnitrade"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Marco Meyer",
            "email": "marco.meyer@glitchr.io"
        }
    ],
    "require": {
        "php": ">=8.2",
        "omnisense/contracts": "^1.0",
        "omnisense/omnitrade": "^1.2",
        "symfony/http-client": "^6.4|^7.0|^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Omnitrade\\PayPal\\": ""
        },
        "exclude-from-classmap": [
            "/Tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Omnitrade\\PayPal\\Tests\\": "Tests/"
        }
    },
    "extra": {
        "omnisense": {
            "policy": "policy.json"
        },
        "branch-alias": {
            "dev-1.x": "1.x-dev"
        }
    },
    "config": {
        "sort-packages": true
    }
}
